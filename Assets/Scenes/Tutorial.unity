--- !u!114 &1173343250
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1173343249}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07411f7ce437efa45824b183a223f48d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialNivel
  passos:
  - titulo: "Bem-vindo \xE0 autoescola!"
    mensagem: "Aqui voc\xEA vai aprender todos os comandos do carro. Siga a pista
      e, no final, estacione dentro da vaga marcada e fique parado por 1 segundo."
    quando: 0
    espera: 0.6
    idGatilho: 
    teclas: 00000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 0}
  - titulo: Acelerar
    mensagem: Segure a SETA PARA CIMA ou W para acelerar. Quando soltar, o carro
      vai parando sozinho.
    quando: 0
    espera: 0.3
    idGatilho: 
    teclas: 0300000007000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 0}
  - titulo: "Frear e dar r\xE9"
    mensagem: "Segure a SETA PARA BAIXO ou S para frear. Se continuar segurando com
      o carro parado, ele anda de r\xE9."
    quando: 0
    espera: 2
    idGatilho: 
    teclas: 0400000009000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 0}
  - titulo: Virar
    mensagem: "SETA PARA A ESQUERDA ou A vira para a esquerda. SETA PARA A DIREITA
      ou D vira para a direita. O carro s\xF3 vira quando est\xE1 andando."
    quando: 0
    espera: 2
    idGatilho: 
    teclas: 0500000008000000060000000a000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 0}
  - titulo: "Freio de m\xE3o"
    mensagem: "Aperte ESPA\xC7O para puxar o freio de m\xE3o. Em alta velocidade,
      segure ESPA\xC7O durante uma curva para derrapar (drift)!"
    quando: 0
    espera: 4
    idGatilho: 
    teclas: 01000000
    fecharComAsTeclas: 1
    pausarJogo: 0
    fecharSozinhoApos: 10
    poder: {fileID: 0}
  - titulo: "Far\xF3is"
    mensagem: "Aperte L para ligar ou desligar os far\xF3is."
    quando: 0
    espera: 4
    idGatilho: 
    teclas: 0b000000
    fecharComAsTeclas: 1
    pausarJogo: 0
    fecharSozinhoApos: 10
    poder: {fileID: 0}
  - titulo: Pausar o jogo
    mensagem: Depois de fechar esta dica, aperte ESC a qualquer momento para pausar
      o jogo.
    quando: 0
    espera: 4
    idGatilho: 
    teclas: 02000000
    fecharComAsTeclas: 0
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 0}
  - titulo: 'Poder: Nitro'
    mensagem: "Aperte CTRL para ativar o nitro: o carro fica muito mais r\xE1pido
      por 3 segundos. Depois ele leva 30 segundos para recarregar."
    quando: 0
    espera: 3
    idGatilho: 
    teclas: 0e000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 11400000, guid: cea02738f1dc76643bfff83182f3fc76, type: 2}
  - titulo: 'Poder: Buzina'
    mensagem: "Aperte H para buzinar: os carros do tr\xE2nsito perto de voc\xEA param
      por alguns segundos. Recarrega em 15 segundos."
    quando: 0
    espera: 1
    idGatilho: 
    teclas: 0c000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 11400000, guid: 84292aadceeab8f429cef0c0227bb353, type: 2}
  - titulo: 'Poder: Mola-de-para-choque'
    mensagem: "Aperte M para ligar um campo de for\xE7a por 5 segundos: carros que
      encostarem em voc\xEA s\xE3o empurrados para longe e voc\xEA n\xE3o perde pontos.
      Recarrega em 20 segundos."
    quando: 0
    espera: 1
    idGatilho: 
    teclas: 0d000000
    fecharComAsTeclas: 1
    pausarJogo: 1
    fecharSozinhoApos: 0
    poder: {fileID: 11400000, guid: 45ea4ed4f5c7b004eafbf77938cbacdb, type: 2}
  - titulo: 'Poder: Advogado'
    mensagem: "Passivo: em cada n\xEDvel, o advogado anula os primeiros 3 pontos
      de dano na sua carteira. N\xE3o precisa apertar nada!"
    quando: 0
