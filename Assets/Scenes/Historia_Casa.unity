  m_EditorClassIdentifier: Assembly-CSharp::ObjetoTurbo
  bloqueia: 1
  celulas:
  - {x: 7, y: 2}
  interagirAoEsbarrar: 0
  falas:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "O meu videogame com o TURBO RACER 3000. Um cl\xE1ssico de 1987!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Meu recorde: {recorde} pontos. Em primeiro lugar: TONH\xC3O, com {tonhao}."
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Ningu\xE9m nunca viu esse Tonh\xE3o. O nome dele j\xE1 veio gravado no
      cartucho!"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "...Depois eu jogo mais. Agora n\xE3o d\xE1 pra deixar o pai esperando."
    emote: 0
    tremer: 0
