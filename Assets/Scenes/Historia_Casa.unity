--- !u!114 &1564211911
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1564211910}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: df290246ebc664a4a9349eb82beb4878, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoteiroCasa
  jogador: {fileID: 210090330}
  pai: {fileID: 855780678}
  mae: {fileID: 380598656}
  porta: {fileID: 1045491931}
  objetivo: {fileID: 907245608}
  dialogo: {fileID: 907245605}
  objetivoInicial: Fale com o seu pai na sala
  objetivoSair: Saia de casa pela porta da frente
  tvQuarto: {fileID: 573249975}
  telaDaTV:
    x: 4
    y: 11
    width: 8
    height: 9
  proximaCena: Historia_Autoescola
  falasAcordar:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "N\xC3\xC3\xC3O!! De novo esse caminh\xE3o!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Esse jogo \xE9 imposs\xEDvel! Quem faz um carro mudar de faixa sem dar
      seta?!"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "{pontos} pontos... E o tal do TONH\xC3O l\xE1 no primeiro lugar com 99999.
      COMO, gente?!"
    emote: 2
    tremer: 0
  - quem: {fileID: 0}
    texto: "S\xE1bado, 7 da manh\xE3. Na casa da fam\xEDlia Driver..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "JAAAASON! Desliga esse videogame e vem tomar caf\xE9! O seu pai quer
      falar com voc\xEA!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "S\xF3 mais uma partidinha, m\xE3e! Eu tava quase passando o caminh\xE3o!"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: AGORA, JASON!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "T\xE1 bom, t\xE1 bom! ...O pai quer falar comigo? Ser\xE1 que ele descobriu
      o arranh\xE3o na bicicleta dele?"
    emote: 5
    tremer: 0
  - quem: {fileID: 0}
    texto: "Use as SETAS ou W A S D para andar, SHIFT para correr e ENTER, ESPA\xC7O
      ou E para conversar e examinar as coisas."
    emote: 0
    tremer: 0
  falasPai:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "\xD4\xF4\xF4, a bela adormecida acordou! Achei que ia ter que te acordar
      com a buzina do Kicks!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Bom dia, pai. A m\xE3e disse que voc\xEA queria falar comigo...?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Queria sim. Senta a\xED. ...N\xE3o, n\xE3o senta, fica em p\xE9 mesmo
      que \xE9 rapidinho."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Filho, voc\xEA fez 18 anos semana passada. E sabe o que isso significa?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Que eu posso comprar bolo sem pedir a sua autoriza\xE7\xE3o?"
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Hahaha! N\xE3o! Significa que t\xE1 na hora de voc\xEA TIRAR A CARTEIRA
      DE MOTORISTA!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "S\xC9RIO?! Pai, eu treino no videogame h\xE1 ANOS! Eu nasci pra isso!
      Eu sou praticamente o MR. DRIVER!"
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Mr. Driver, \xE9? Hehe. Trinta anos de t\xE1xi e eu nunca levei uma multa."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "...Bom, s\xF3 aquela vez. E aquela outra. Mas aquelas n\xE3o contam."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Mas escuta: dirigir de verdade n\xE3o \xE9 igual ao seu videogame, filho.
      Na rua n\xE3o tem \"continue\"."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Eu j\xE1 te matriculei na Autoescola Freio de M\xE3o. O instrutor \xE9
      o Gerv\xE1sio, meu amigo de inf\xE2ncia."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Primeiro, aulas no p\xE1tio da autoescola. Depois, o EXAME FINAL pelas
      ruas da cidade!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "E voc\xEA vai fazer tudo isso... com o meu NISSAN KICKS NOVINHO!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "O SEU KICKS?! Voc\xEA n\xE3o deixa nem eu encostar nele! Voc\xEA d\xE1
      bom dia pra ele!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Claro que dou! Ele tem c\xE2mera 360, alerta de ponto cego, sensor de
      estacionamento, frenagem de emerg\xEAncia..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Ele \xE9 praticamente mais inteligente que eu. Ent\xE3o trata ele com
      carinho, viu?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "O Gerv\xE1sio j\xE1 t\xE1 te esperando na autoescola. Vai l\xE1, campe\xE3o!
      E escuta TUDO o que ele falar!"
    emote: 0
    tremer: 0
  falasPaiDepois:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Vai l\xE1, campe\xE3o! O Gerv\xE1sio n\xE3o gosta de esperar. Ele fica
      nervoso."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: ...Bom, ele fica nervoso com tudo. Mas com espera ele fica MAIS.
    emote: 0
    tremer: 0
  falasMaeAntes:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Bom dia, meu amor! Vai falar com o seu pai, ele t\xE1 todo misterioso
      desde ontem!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "E come alguma coisa antes! Saco vazio n\xE3o para em p\xE9!"
    emote: 0
    tremer: 0
  falasMae:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: Seu pai me contou tudo! Meu filho vai DIRIGIR?!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Ai, meu Deus. T\xE1. T\xE1 tudo bem. Eu t\xF4 calma. EU T\xD4 CALMA!"
    emote: 5
    tremer: 1
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Regra n\xFAmero um: CINTO DE SEGURAN\xC7A! Regra n\xFAmero dois: CINTO
      DE SEGURAN\xC7A! Regra n\xFAmero tr\xEAs..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Deixa eu adivinhar... cinto de seguran\xE7a?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "N\xE3o! Regra n\xFAmero tr\xEAs \xE9: me liga quando chegar. Mas usa
      o cinto tamb\xE9m!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Toma, fiz uma marmita pra voc\xEA. Prova de dire\xE7\xE3o d\xE1 fome."
    emote: 3
    tremer: 0
  - quem: {fileID: 0}
    texto: "Jason guardou a marmita da m\xE3e na mochila. Tem cheiro de lasanha."
    emote: 0
    tremer: 0
  falasMaeDepois:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Cinto! Retrovisor! Seta! E n\xE3o fala com estranhos!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "...A n\xE3o ser com o instrutor. Com o instrutor pode falar."
    emote: 0
    tremer: 0
  falasPortaFechada:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Melhor falar com o pai antes de sair. Sen\xE3o ele me liga dezessete
      vezes."
    emote: 5
    tremer: 0
  falasSaida:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: JASON! ESPERA!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Que foi, m\xE3e?!"
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: ...Boa sorte, filho. Eu te amo.
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: E USA O CINTO!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Tamb\xE9m te amo, m\xE3e! Fui!"
    emote: 0
    tremer: 0
