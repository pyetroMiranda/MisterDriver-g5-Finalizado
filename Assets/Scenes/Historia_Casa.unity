  falas:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "P\xE3o na chapa, caf\xE9 com leite e um bilhetinho:"
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: "\"Boa sorte hoje, filho! Voc\xEA vai arrasar. Beijos, m\xE3e e pai.\""
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Boa sorte...? Pra qu\xEA?"
    emote: 2
    tremer: 0
  falasDepois:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Ah, ent\xE3o ERA por isso o bilhete de boa sorte!"
    emote: 1
    tremer: 0
