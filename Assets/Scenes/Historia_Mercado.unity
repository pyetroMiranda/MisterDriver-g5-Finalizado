  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 81fc026f81694a44f97c5e932eb59c1f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoteiroMercado
  jogador: {fileID: 1546774697}
  atendente: {fileID: 8897031}
  porta: {fileID: 698792595}
  objetivo: {fileID: 110794376}
  dialogo: {fileID: 110794373}
  lista:
  - id: leite
    nome: leite
  - id: ovos
    nome: ovos
  - id: pao
    nome: "p\xE3o de forma"
  - id: cafe
    nome: "caf\xE9"
  - id: fermento
    nome: fermento
  rebeldes:
  - npc: {fileID: 1776157042}
    entrada:
    - direcao: 1
      quantidade: 2
    - direcao: 3
      quantidade: 2
    olhando: 3
    saida:
    - direcao: 2
      quantidade: 2
    - direcao: 0
      quantidade: 2
  - npc: {fileID: 1719382740}
    entrada:
    - direcao: 1
      quantidade: 3
    - direcao: 2
      quantidade: 3
    olhando: 0
    saida:
    - direcao: 3
      quantidade: 3
    - direcao: 0
      quantidade: 3
  - npc: {fileID: 216475413}
    entrada:
    - direcao: 1
      quantidade: 3
    - direcao: 3
      quantidade: 4
    olhando: 3
    saida:
    - direcao: 2
      quantidade: 4
    - direcao: 0
      quantidade: 3
  latas: {fileID: 320003955}
  latasDerrubadas: {fileID: 21300000, guid: 87be7eada1c6eb04e9a1871481735127, type: 3}
  objetoLatas: {fileID: 320003953}
  objetivoCompras: 'Pegue as compras ({n} de {total}): {lista}'
  objetivoCaixa: "V\xE1 at\xE9 o caixa e pague as compras"
  objetivoSair: Saia do mercado e volte para o carro
  proximaCena: Nivel1
  falasEntrada:
  - quem: {fileID: 0}
    texto: "Mercado Bom Pre\xE7o. Ar condicionado, musiquinha ambiente e cheiro de
      p\xE3o quentinho."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Bom, a lista: leite, ovos, p\xE3o de forma, caf\xE9 e fermento."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Pego tudo, passo no caixa e volto pra casa. Moleza!
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: Ande pelos corredores e examine as prateleiras com ENTER para pegar as
      compras.
    emote: 0
    tremer: 0
  falasJaPegou:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Esse eu j\xE1 peguei."
    emote: 0
    tremer: 0
  falasCaixaAntes:
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Opa! Ainda t\xE1 faltando coisa da lista, n\xE9? Eu vejo no seu olhar."
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: Pode ir, que eu espero. *ploc* (bola de chiclete)
    emote: 0
    tremer: 0
  falasCaixa:
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Boa tarde! Bem-vindo ao Bom Pre\xE7o! Eu sou a Jussara. *ploc*"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Leite, ovos, p\xE3o de forma, caf\xE9, fermento... Hmm, a Dona Cida vai
      fazer bolo, n\xE9?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Como voc\xEA sabe que eu sou filho da Dona Cida?!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Querido, eu sei de TUDO nessa cidade. Voc\xEA \xE9 o Jason, que passou
      no exame hoje. O Gerv\xE1sio ainda t\xE1 deitado."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "E aquele carro l\xE1 fora \xE9 seu? Que lindo! Eu AMO carro."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "\xD3, dica de amiga: meu primo Tonh\xE3o vai abrir uma loja de pe\xE7as
      ali na avenida. A TURBO PE\xC7AS!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Pneu melhor, freio melhor, suspens\xE3o... Tudo pra deixar seu carro
      mais seguro e mais esperto."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Ainda t\xE1 em reforma, mas logo abre. Guarda suas moedas, hein?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Turbo Pe\xE7as... Vou lembrar!"
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Deu tudo vinte e tr\xEAs e cinquenta. Quer sacolinha?"
    emote: 0
    tremer: 0
  falasChegadaRebeldes:
  - quem: {fileID: 0}
    texto: VRUUUM! VRUM VRUM! CRASH!
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Ah, n\xE3o... De novo N\xC3O!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Que barulho foi esse?!
    emote: 2
    tremer: 0
  falasBaderna:
  - quem: {fileID: 11400000, guid: 69eb7e7749d296e4aa462a83e9e4b880, type: 2}
    texto: "E A\xCD, BOM PRE\xC7O! A GANGUE DO ESCAPAMENTO CHEGOU!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "TURBO! J\xE1 falei que \xE9 proibido entrar de skate, de patins E DE
      MOTO no mercado!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 69eb7e7749d296e4aa462a83e9e4b880, type: 2}
    texto: "Relaxa, Jussara! A gente s\xF3 veio buscar refrigerante... e derrubar
      umas latinhas."
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: 69eb7e7749d296e4aa462a83e9e4b880, type: 2}
    texto: "Opa! Quem \xE9 esse a\xED? Cara de carteira nova!"
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Eu sou o Jason. E voc\xEAs deixaram as motos em cima da cal\xE7ada, na
      vaga para pessoas com defici\xEAncia e na faixa de pedestre!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 69eb7e7749d296e4aa462a83e9e4b880, type: 2}
    texto: "HAHAHA! Placa? Faixa? Sem\xE1foro? A gente n\xE3o liga pra nada disso!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "As leis de tr\xE2nsito existem pra proteger todo mundo. Inclusive voc\xEAs."
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 69eb7e7749d296e4aa462a83e9e4b880, type: 2}
    texto: "Ih, olha o certinho! Quero ver voc\xEA chegar em casa inteiro, novato.
      A cidade agora \xE9 NOSSA!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 69eb7e7749d296e4aa462a83e9e4b880, type: 2}
    texto: GALERA! PRA RUA! VRUUUUM!
    emote: 1
    tremer: 1
  falasDepoisBaderna:
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Aff... Desculpa a bagun\xE7a, Jason. Esses s\xE3o os rebeldes da Gangue
      do Escapamento."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Andam de carro pichado e de moto, sem respeitar NENHUMA lei de tr\xE2nsito.
      Racha, contram\xE3o, sinal vermelho..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Toma cuidado na volta pra casa, viu? Eles v\xE3o estar pelas ruas."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Pode deixar, Jussara. Eles fazem tudo errado... e eu vou fazer tudo certo.
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Assim que eu gosto! E lembra da Turbo Pe\xE7as! *ploc*"
    emote: 3
    tremer: 0
  falasAtendenteDepois:
  - quem: {fileID: 11400000, guid: b13ecb943ed074b47bcfd2fc5b49c5bd, type: 2}
    texto: "Cuidado com a Gangue do Escapamento l\xE1 fora! E volta sempre! *ploc*"
    emote: 0
    tremer: 0
  falasLatasDerrubadas:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "A pir\xE2mide de latas... destru\xEDda. Coitado de quem montou."
    emote: 0
    tremer: 0
  falasSaida:
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Compras no carro. Agora \xE9 voltar pra casa com MUITA aten\xE7\xE3o."
    emote: 0
    tremer: 0
