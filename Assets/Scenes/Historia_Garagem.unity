    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Depois de dirigir de verdade, esse jogo at\xE9 parece f\xE1cil..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "...Mentira. Continua imposs\xEDvel. E o Tonh\xE3o continua l\xE1 em cima
      com {tonhao}."
    emote: 5
    tremer: 0
