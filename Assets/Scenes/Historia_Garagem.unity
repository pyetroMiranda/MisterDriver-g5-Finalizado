--- !u!114 &210649246
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 210649245}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f51eece8d4dee6f4b98ebc4b27dd4758, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoteiroGaragem
  jogador: {fileID: 1603949795}
  pai: {fileID: 2046947864}
  mae: {fileID: 1515353578}
  portaGaragem: {fileID: 128296279}
  portao: {fileID: 390593874}
  objetivo: {fileID: 95042968}
  dialogo: {fileID: 95042966}
  telaGaragem: {fileID: 95042964}
  paiAtePorta:
  - direcao: 1
    quantidade: 2
  - direcao: 3
    quantidade: 5
  - direcao: 1
    quantidade: 1
  paiNaPorta: 3
  maeAteCozinha:
  - direcao: 1
    quantidade: 4
  maeNaCozinha: 2
  paiAteGaragem:
  - direcao: 3
    quantidade: 3
  - direcao: 0
    quantidade: 3
  paiNaGaragem: 3
  inicioGaragemX: 22
  objetivoPai: Encontre o seu pai na porta da garagem
  objetivoEntrar: Entre na garagem
  objetivoEscolher: Chegue perto do carro e aperte ENTER
  objetivoSair: "Saia de carro pelo port\xE3o da garagem"
  proximaCena: Nivel1
  falasChegada:
  - quem: {fileID: 0}
    texto: De volta para casa. Com a carteira de motorista no bolso.
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "ELE CHEGOU! BET\xC3O, ELE CHEGOOOU!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "E a\xED, campe\xE3o? Como foi? Pode falar. Eu aguento."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Pai... m\xE3e..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "EU PASSEI! T\xC1 AQUI A MINHA CARTEIRA!"
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "AAAAAH! MEU BEB\xCA \xC9 MOTORISTA!"
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: Deixa eu ver a foto! ...Ai, que lindo! Saiu de olho fechado, mas que lindo!
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "EU SABIA! Puxou o pai! Trinta anos de t\xE1xi correm nessas veias!"
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "E o Gerv\xE1sio? Sobreviveu?"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Ele disse que ia deitar um pouquinho.
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: Hehe, normal. Quando eu tirei a carteira com ele, ele deitou uma semana.
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Bom... agora que voc\xEA \xE9 motorista de verdade, eu tenho uma SURPRESA."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Me encontra na porta da GARAGEM, ali no canto da sala. Sem pressa: d\xE1
      uma volta, come alguma coisa..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Isso! Eu fiz PUDIM pra comemorar! T\xE1 na mesa da cozinha. S\xF3 UM
      peda\xE7o!"
    emote: 3
    tremer: 0
  - quem: {fileID: 0}
    texto: "Ande pela casa \xE0 vontade. Quando estiver pronto, fale com o pai na
      porta da garagem."
    emote: 0
    tremer: 0
  falasPaiPorta:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: Chegou! Pronto pra surpresa?
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Essa porta aqui, filho... \xE9 a GARAGEM. A partir de hoje, voc\xEA tamb\xE9m
      tem a chave."
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: "O pai tirou do bolso um chaveiro com um tax\xEDmetro de miniatura. CLIC!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Vem comigo. E n\xE3o repara a bagun\xE7a."
    emote: 0
    tremer: 0
  falasAulaGaragem:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Bem-vindo \xE0 GARAGEM DO BET\xC3O!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Ferramentas, pneus, tinta... e a minha bicicleta. Que algu\xE9m arranhou,
      ali\xE1s."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Nossa, que coisa, n\xE9? Quem ser\xE1?"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: E ali, filho... a estrela da casa. O meu NISSAN KICKS!
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "C\xE2mera 360 pra estacionar, alerta de ponto cego, frenagem de emerg\xEAncia,
      central multim\xEDdia... \xC9 tecnologia que n\xE3o acaba mais!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Pai, voc\xEA t\xE1 chorando?"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "\xC9 o cheiro de carro novo. Bate na emo\xE7\xE3o."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Ele agora \xE9 seu tamb\xE9m. E n\xE3o \xE9 s\xF3 ele: os meus amigos
      do ponto de t\xE1xi deixam uns carros guardados aqui."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: 'Pode escolher QUALQUER UM. E aquela prateleira tem tinta de todas as
      cores: pode pintar do jeito que quiser!'
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "QUALQUER UM?! Pai, voc\xEA \xE9 o melhor pai do mundo!"
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Eu sei. Agora presta aten\xE7\xE3o, que \xE9 igual autoescola:"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: Chegue perto do carro e aperte ENTER para abrir a garagem.
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: SETAS para os lados trocam o carro. SETAS para cima e para baixo trocam
      a cor. ENTER confirma e ESC volta.
    emote: 0
    tremer: 0
  falasPaiEscolher:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Chegue perto do carro e aperte ENTER. Escolha com o cora\xE7\xE3o!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "...E com o bolso tamb\xE9m. Mas hoje \xE9 por minha conta."
    emote: 0
    tremer: 0
  falasDesistiu:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Ficou na d\xFAvida? Normal. Eu fiz tr\xEAs test drives antes de escolher
      o Kicks."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Quando quiser, \xE9 s\xF3 chegar perto do carro e apertar ENTER."
    emote: 0
    tremer: 0
  falasEscolheuKicks:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: O KICKS! Escolha de quem entende de carro!
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Com o alerta de ponto cego e a frenagem de emerg\xEAncia, eu fico at\xE9
      mais tranquilo. Ele cuida de voc\xEA."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Mas lembra: tecnologia ajuda, quem dirige com cuidado \xE9 VOC\xCA."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Prometo, pai!
    emote: 0
    tremer: 0
  falasPintouKicks:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Voc\xEA PINTOU o meu Kicks?!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: ...
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: Sabe que ficou estiloso? Tecnologia de ponta E personalidade. Gostei!
    emote: 3
    tremer: 0
  falasEscolheuOutro:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Trocou o Kicks por ESSE a\xED?!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "O Kicks tem c\xE2mera 360, filho! C\xC2MERA. TRE-ZEN-TOS E SES-SEN-TA!"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Pai, \xE9 s\xF3 pra ir no mercado..."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "T\xE1 bom, t\xE1 bom. Mas se mudar de ideia, ele t\xE1 aqui. Brilhando."
    emote: 0
    tremer: 0
  falasMercado:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: JAAAASON!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Que foi, m\xE3e?!"
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "J\xE1 que agora voc\xEA \xE9 MOTORISTA... vai no mercado pra mim? Acabou
      o leite!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Claro! Primeira miss\xE3o oficial do Mr. Driver!"
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Anota: leite, ovos, p\xE3o de forma e caf\xE9. E NADA de pudim! Ainda
      tem pudim aqui!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "O Mercado Bom Pre\xE7o fica l\xE1 do outro lado da cidade. Voc\xEA vai
      ter que atravessar tudo."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Vai com calma e com SEGURAN\xC7A. Cada batida tira pontos da sua carteira."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Carteira suspensa = carro de volta pra garagem e voc\xEA de volta pra
      bicicleta."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: A bicicleta arranhada?
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: ...Essa mesma.
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Vou abrir o port\xE3o. Quando estiver pronto, \xE9 s\xF3 sair com o carro
      por ali!"
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: "Voc\xEA pode trocar de carro de novo antes de sair. Saia pelo port\xE3o
      da garagem quando quiser."
    emote: 0
    tremer: 0
  falasTrocouDeNovo:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Mudou de novo? Voc\xEA \xE9 igualzinho a sua m\xE3e escolhendo roupa."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "...N\xE3o conta pra ela que eu disse isso."
    emote: 0
    tremer: 0
  falasPaiDepois:
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "O port\xE3o t\xE1 aberto, Mr. Driver! Leite, ovos, p\xE3o e caf\xE9."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "E traz o troco! O troco \xE9 sagrado."
    emote: 0
    tremer: 0
  falasMaeAntes:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "J\xE1 liguei pra sua tia, pra sua av\xF3 e pro grupo da fam\xEDlia. Todo
      mundo sabe que voc\xEA passou!"
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "O pudim t\xE1 na mesa. S\xF3 um peda\xE7o! ...T\xE1 bom, dois. Hoje \xE9
      dia de festa."
    emote: 0
    tremer: 0
  falasMaeDepois:
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: "Leite, ovos, p\xE3o de forma e caf\xE9! Repete comigo!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Leite, ovos, p\xE3o de forma e caf\xE9..."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: E NADA de pudim! E USA O CINTO!
    emote: 1
    tremer: 1
  falasSaida:
  - quem: {fileID: 0}
    texto: Jason entrou no carro, ajustou o banco, os retrovisores e...
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: cd42fcd6e5830b243a6f9a1f11dd4d30, type: 2}
    texto: O CINTOOO!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "T\xD4 DE CINTO, M\xC3E!"
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 264fd7b28985a0c45957f16d04f13b4b, type: 2}
    texto: "Vai com Deus, Mr. Driver! E cuida bem da m\xE1quina!"
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: "E l\xE1 foi o Jason, pela primeira vez sozinho, para as ruas da cidade..."
    emote: 0
    tremer: 0
