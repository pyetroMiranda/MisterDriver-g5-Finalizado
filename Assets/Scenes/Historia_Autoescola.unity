--- !u!114 &594576247
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 594576246}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78e4f272beb2acb41a3159896dbe60ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissaoExame
  carro: {fileID: 395781592}
  carteira: {fileID: 395781591}
  dialogo: {fileID: 1725776270}
  objetivo: {fileID: 1725776268}
  seta: {fileID: 641751360}
  telaCarteira: {fileID: 0}
  jason: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
  instrutor: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
  limiteFaltas: 10
  intervaloComentarios: 1.5
  proximaCena: Historia_Exame
  cenaConcluida: Historia_Autoescola
  mostrarCarteira: 0
  falasAbertura:
  - quem: {fileID: 0}
    texto: "Autoescola Freio de M\xE3o. O p\xE1tio de treino mais famoso (e mais
      amassado) da cidade."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Uau... que gr\xE1ficos!"
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Gr\xE1ficos? Que gr\xE1ficos? \xC9 um p\xE1tio, menino."
    emote: 2
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Bom dia! Eu sou o Gerv\xE1sio, seu instrutor. Vinte e cinco anos de profiss\xE3o!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "E s\xF3 tr\xEAs pontes de safena."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Prazer, seu Gerv\xE1sio! Pode ficar tranquilo, eu nasci pra isso!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Todos dizem isso... Todos. Dizem. Isso.
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Antes do exame na cidade, voc\xEA vai fazer CINCO aulas aqui no p\xE1tio.
      Cada uma est\xE1 pintada no ch\xE3o."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Derrubou cone, bateu no muro? FALTA. Com 10 faltas a gente come\xE7a
      tudo de novo. E eu tomo meu rem\xE9dio."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: 'AULA 1: a RETA. Segure W ou a SETA PARA CIMA para andar. Siga a seta
      amarela!'
    emote: 0
    tremer: 0
  etapas:
  - objetivo: 'Aula 1: entre na reta e acelere'
    ponto: {fileID: 1141438544}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Isso! Agora l\xE1 no fim da reta tem a faixa de PARE."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: Para frear, segure S ou a SETA PARA BAIXO. Pare o carro em cima do PARE,
        sem passar da linha!
      emote: 0
      tremer: 0
  - objetivo: 'Aula 1: pare o carro na faixa de PARE'
    ponto: {fileID: 1739666612}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Parou certinho! Meu cora\xE7\xE3o nem acelerou."
      emote: 3
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: 'AULA 2: CURVAS. Vire com A e D, ou com as setas dos lados.'
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "D\xEA uma volta inteira no circuito em volta da ilha, seguindo as setas
        do ch\xE3o. E tira o p\xE9 na curva!"
      emote: 0
      tremer: 0
  - objetivo: "Aula 2: siga o circuito pelas setas do ch\xE3o (1/5)"
    ponto: {fileID: 1086242736}
    falasAntes: []
    falasAoChegar: []
  - objetivo: "Aula 2: siga o circuito pelas setas do ch\xE3o (2/5)"
    ponto: {fileID: 465636600}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: Boa curva! Agora a de cima... devagarinho, com amor.
      emote: 0
      tremer: 0
  - objetivo: "Aula 2: siga o circuito pelas setas do ch\xE3o (3/5)"
    ponto: {fileID: 248571592}
    falasAntes: []
    falasAoChegar: []
  - objetivo: "Aula 2: siga o circuito pelas setas do ch\xE3o (4/5)"
    ponto: {fileID: 899509890}
    falasAntes: []
    falasAoChegar: []
  - objetivo: "Aula 2: siga o circuito pelas setas do ch\xE3o (5/5)"
    ponto: {fileID: 1750748555}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
      texto: "Viu s\xF3? Curva \xE9 comigo mesmo!"
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "T\xE1 bom, t\xE1 bom. AULA 3: SLALOM. V\xE1 at\xE9 o corredor de cones
        ali na direita."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Costure entre os cones do meio sem derrubar NENHUM. Eles t\xEAm fam\xEDlia
        tamb\xE9m."
      emote: 0
      tremer: 0
  - objetivo: 'Aula 3: entre no corredor de cones'
    ponto: {fileID: 168689984}
    falasAntes: []
    falasAoChegar: []
  - objetivo: "Aula 3: costure entre os cones at\xE9 a chegada"
    ponto: {fileID: 1334637785}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Que eleg\xE2ncia! Parecia um bal\xE9!"
      emote: 3
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "AULA 4: GARAGEM. Essa \xE9 de R\xC9. Voc\xEA vai entrar DE COSTAS na
        garagem de cones l\xE1 em cima."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Pare na frente dela com o carro virado para baixo e segure S: com o
        carro parado, ele anda de r\xE9."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "A \xE1rea fica AMARELA se voc\xEA entrar de frente. Tem que ficar VERDE!"
      emote: 0
      tremer: 0
  - objetivo: "Aula 4: estacione DE R\xC9 dentro da garagem"
    ponto: {fileID: 1846988741}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "DE R\xC9! Que orgulho. Vou contar para o seu pai."
      emote: 3
      tremer: 0
    - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
      texto: "Ele vai dizer que no tempo dele era mais dif\xEDcil."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "E era mesmo. AULA 5: a temida BALIZA. Estacione na vaga amarela, paralelo
        \xE0 cal\xE7ada."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Passe da vaga, pare, e entre de r\xE9 virando o volante. Calma que
        d\xE1!"
      emote: 0
      tremer: 0
  - objetivo: "Aula 5: fa\xE7a a baliza na vaga amarela"
    ponto: {fileID: 2033804336}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "BALIZA PERFEITA! ...Bom, quase. Mas t\xE1 dentro!"
      emote: 1
      tremer: 1
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "\xDAltima tarefa: estacione na VAGA em frente \xE0 autoescola. Tem
        um cafezinho me esperando l\xE1."
      emote: 0
      tremer: 0
  - objetivo: "Estacione na VAGA em frente \xE0 autoescola"
    ponto: {fileID: 1759107871}
    falasAntes: []
    falasAoChegar: []
  reacoesBatida:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "AI, MEU CORA\xC7\xC3O! Isso era um MURO!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: O KICKS NOVO DO SEU PAI! Ele vai me matar!
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Respira, Gerv\xE1sio... respira... Um, dois, tr\xEAs..."
    emote: 5
    tremer: 0
  reacoesCone:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: O CONE! Coitado do cone!
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Cone \xE9 pra DESVIAR, n\xE3o pra abra\xE7ar!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Mais um cone pra minha cole\xE7\xE3o de traumas..."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Esse cone tinha nome, Jason! Era o Jorginho!
    emote: 5
    tremer: 0
  falasReprovado:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Chega, chega, CHEGA! Dez faltas!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Respira fundo, Jason. Eu tamb\xE9m respiro. Vamos come\xE7ar as aulas
      de novo."
    emote: 5
    tremer: 0
  falasAprovadoPerfeito:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Todas as aulas com ZERO faltas! Em 25 anos eu nunca vi isso!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Eu falei que nasci pra isso!
    emote: 3
    tremer: 0
  falasAprovado:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Aulas conclu\xEDdas! Com {faltas} falta(s), mas conclu\xEDdas."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Bora! T\xF4 pronto!"
    emote: 0
    tremer: 0
  falasDespedida:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Agora vem o que importa: o EXAME FINAL. L\xE1 fora, na cidade."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Com tr\xE2nsito de verdade, pedestres de verdade e buracos de verdade."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Com... tr\xE2nsito de verdade?"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Bem-vindo \xE0 vida real, Mr. Driver. Vamos!"
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: "Gerv\xE1sio respirou fundo tr\xEAs vezes. E l\xE1 foram eles, para as
      ruas da cidade..."
    emote: 0
    tremer: 0
