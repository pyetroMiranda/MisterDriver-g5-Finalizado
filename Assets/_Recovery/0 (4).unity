--- !u!114 &371187229
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 371187228}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78e4f272beb2acb41a3159896dbe60ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissaoExame
  carro: {fileID: 1837835299}
  carteira: {fileID: 1764842235}
  dialogo: {fileID: 1128790040}
  objetivo: {fileID: 1128790039}
  seta: {fileID: 1842803476}
  telaCarteira: {fileID: 1128790037}
  jason: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
  instrutor: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
  limiteFaltas: 5
  intervaloComentarios: 1.5
  proximaCena: Historia_Garagem
  cenaConcluida: Historia_Exame
  mostrarCarteira: 1
  falasAbertura:
  - quem: {fileID: 0}
    texto: "EXAME FINAL. As ruas da cidade, com tr\xE2nsito de verdade."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Aqui fora \xE9 diferente, Jason. Carros, pedestres, buracos... e nenhum
      cone pra te proteger."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: 'Cada batida tira pontos da carteira e vira falta. Bateu 5 vezes: REPROVADO.
      E eu tenho um treco.'
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: Pode deixar. Eu treinei com o melhor instrutor da cidade!
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "...Isso foi um elogio? Ai, meu cora\xE7\xE3o."
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Siga a seta amarela at\xE9 o primeiro ponto. Devagarinho. Com amor."
    emote: 0
    tremer: 0
  etapas:
  - objetivo: "Siga a seta amarela at\xE9 o ponto marcado"
    ponto: {fileID: 1511199067}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: Muito bem! Viu? Nem doeu. Pelo menos em mim.
      emote: 3
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Cuidado com os outros carros: eles param nos cruzamentos e para os
        pedestres. Voc\xEA tamb\xE9m!"
      emote: 0
      tremer: 0
  - objetivo: Continue seguindo a seta
    ponto: {fileID: 484428799}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
      texto: "T\xF4 pegando o jeito, seu Gerv\xE1sio!"
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "T\xE1 sim. Eu t\xF4 at\xE9 respirando normal. Olha s\xF3."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Agora presta aten\xE7\xE3o: no pr\xF3ximo ponto tem uma placa de PARE."
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "PARAR \xE9 PARAR, hein? Carro parado de verdade. Nada de \"quase parar\"!"
      emote: 1
      tremer: 1
  - objetivo: Pare o carro totalmente na placa de PARE
    ponto: {fileID: 1797521100}
    falasAntes: []
    falasAoChegar:
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: Isso! Parou bonitinho! Meu cardiologista vai ficar orgulhoso.
      emote: 3
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Ah, e o freio de m\xE3o \xE9 o ESPA\xC7O. Mas NADA de ficar derrapando
        no meu exame, ouviu?!"
      emote: 0
      tremer: 0
    - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
      texto: "Igualzinho na autoescola: \xFAltima tarefa, estacionar na vaga. Com
        calma."
      emote: 0
      tremer: 0
  - objetivo: Estacione dentro da vaga e fique parado
    ponto: {fileID: 663960844}
    falasAntes: []
    falasAoChegar: []
  reacoesBatida:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Aqui n\xE3o tem ficha extra, hein! Isso n\xE3o \xE9 videogame!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "AI, MEU CORA\xC7\xC3O!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "CAD\xCA A SETA?! ...Quer dizer, CAD\xCA O FREIO?!"
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Isso vai para a minha prancheta... em vermelho.
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Eu tenho FAM\xCDLIA, Jason!"
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: O KICKS NOVO DO SEU PAI! Ele vai me matar!
    emote: 1
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Respira, Gerv\xE1sio... respira... Um, dois, tr\xEAs..."
    emote: 5
    tremer: 0
  reacoesCone: []
  falasReprovado:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: PARA! PARA TUDO! Chega, chega, chega!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Jason, voc\xEA est\xE1... REPROVADO."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Ah, n\xE3o..."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Calma, calma. Todo mundo reprova uma vez. Eu reprovei sete.
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Respira fundo e vamos tentar de novo do come\xE7o."
    emote: 0
    tremer: 0
  falasAprovadoPerfeito:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Estacionou! E com ZERO faltas!
    emote: 1
    tremer: 1
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Em 25 anos eu nunca vi isso. Vou at\xE9 contar pra minha cardiologista!"
    emote: 3
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Jason Driver... voc\xEA est\xE1 APROVADO!"
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: EU SABIA! EU SOU O MR. DRIVER!
    emote: 3
    tremer: 1
  falasAprovado:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: Estacionou! Com {faltas} falta(s), mas estacionou.
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "E o meu cora\xE7\xE3o continua batendo, ent\xE3o... voc\xEA est\xE1 APROVADO!"
    emote: 3
    tremer: 1
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: AEEEE! EU SOU O MR. DRIVER!
    emote: 3
    tremer: 1
  falasDespedida:
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Agora vai l\xE1, Mr. Driver. As ruas s\xE3o suas."
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Respeite os outros carros, os pedestres e os buracos. E cuide dessa carteira:
      s\xE3o 20 pontos!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "Se bater muito, ela \xE9 suspensa. E a\xED voc\xEA volta pra MIM."
    emote: 5
    tremer: 0
  - quem: {fileID: 11400000, guid: 3035290d7e5a5ba428f01eafca05c254, type: 2}
    texto: "Pode deixar, seu Gerv\xE1sio! Obrigado por tudo!"
    emote: 0
    tremer: 0
  - quem: {fileID: 11400000, guid: 1d33b8edff60d4247b0685e7acc1d8a3, type: 2}
    texto: "De nada. Agora, se me der licen\xE7a... eu vou deitar um pouquinho."
    emote: 0
    tremer: 0
  - quem: {fileID: 0}
    texto: Com a carteira no bolso, Jason voltou correndo para casa para contar a
      novidade...
    emote: 0
    tremer: 0
